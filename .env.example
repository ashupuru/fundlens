# Copy to .env and fill in for local development. Never commit the real .env.

# Path to the local SQLite DB file. Defaults to
# ~/Library/Application Support/FundLens/fundlens.db if unset.
FUNDLENS_DB_PATH=

# Origins allowed to call the API in dev (comma-separated), e.g. the Vite dev server.
FUNDLENS_CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# Required only for the AI analysis layer (docs/architecture/ai-layer.md); the
# rest of the app runs fully offline without it.
FUNDLENS_ANTHROPIC_API_KEY=
